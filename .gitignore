# Build output (binaries never go to git)
build/bin/
build/windows/installer/output/
build/windows/icon.ico

# Bindings generated by wails (rebuilt on every build)
frontend/wailsjs/

# Build-time server settings (the server address is not part of the source)
release.env

# Binaries in general, and NOTHING from the game (exe/dll/pak) ever enters the repo
*.exe
*.exe~
*.dll
*.pak
*.syso

# Editors / OS
.vscode/
Thumbs.db
desktop.ini
